{
  "$schema": "./config.schema.json",
  "schema_version": "3.0",
  "capabilities": [
    "CORE_INTEROP", "ADVANCED_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "SPECIAL_STATUS_MESSAGE", "DATA_FRAME_PADDING",
    "CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING",
    "ORCA", "SINGLE_INVOCATION_SUITE", "AUTH_CREDS", "AUTH_KEY_FILE_FLAG", "AUTH_KEY_FILE_ENV",
    "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "GCE_OAUTH2", "OAUTH2_DEFAULT_ACCOUNT_ARG",
    "HTTP2_INTEROP", "HTTP2_SERVER_INTEROP", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "TLS", "INSECURE", "ALTS"
  ],
  "prod_servers": {
    "default": "grpc-test.sandbox.googleapis.com",
    "gateway_v4": "grpc-test4.sandbox.googleapis.com"
  },
  "prod_server_capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "HTTP2_INTEROP", "AUTH_CREDS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "TLS"],
  "server_order": ["c++", "node", "aspnetcore", "java", "go", "ruby", "python", "dart", "pythonasyncio", "php7"],
  "http2_badserver_client_order": ["java", "go", "python", "c++"],
  "alts_language_order": ["java", "go", "c++", "python"],
  "test_cases": {
    "standard": {
      "default_capabilities": ["CORE_INTEROP"],
      "cases": [
        "large_unary", "empty_unary", "ping_pong", "empty_stream",
        "client_streaming", "server_streaming", "cancel_after_begin", "cancel_after_first_response",
        {"name": "timeout_on_sleeping_server", "capabilities": ["TIMEOUT_ON_SLEEPING_SERVER"]},
        {"name": "custom_metadata", "capabilities": ["ADVANCED_INTEROP"]},
        {"name": "status_code_and_message", "capabilities": ["ADVANCED_INTEROP"]},
        {"name": "unimplemented_method", "capabilities": ["ADVANCED_INTEROP"]},
        {"name": "client_compressed_unary", "capabilities": ["CLIENT_COMPRESSION_UNARY"]},
        {"name": "server_compressed_unary", "capabilities": ["SERVER_COMPRESSION_UNARY"]},
        {"name": "client_compressed_streaming", "capabilities": ["CLIENT_COMPRESSION_STREAMING"]},
        {"name": "server_compressed_streaming", "capabilities": ["SERVER_COMPRESSION_STREAMING"]},
        {"name": "unimplemented_service", "capabilities": ["ADVANCED_INTEROP"]},
        {"name": "special_status_message", "capabilities": ["SPECIAL_STATUS_MESSAGE"]},
        {"name": "orca_per_rpc", "capabilities": ["ORCA"], "extra_c2c_flags": ["--service_config_json='{\"loadBalancingConfig\":[{\"test_backend_metrics_load_balancer\":{}}]}'"]},
        {"name": "orca_oob", "capabilities": ["ORCA"], "extra_c2c_flags": ["--service_config_json='{\"loadBalancingConfig\":[{\"test_backend_metrics_load_balancer\":{}}]}'"]}
      ]
    },
    "auth": {
      "default_capabilities": ["AUTH_CREDS"],
      "cases": [
        {"name": "compute_engine_creds", "requires_compute_engine_creds": true, "uses_oauth_scope": true, "uses_default_service_account": true},
        {"name": "jwt_token_creds", "uses_service_account_key": true},
        {"name": "oauth2_auth_token", "uses_service_account_key": true, "uses_oauth_scope": true, "requires_compute_engine_creds_capability": "GCE_OAUTH2", "uses_default_service_account_capability": "OAUTH2_DEFAULT_ACCOUNT_ARG"},
        {"name": "per_rpc_creds", "uses_service_account_key": true, "uses_oauth_scope": true},
        {"name": "google_default_credentials", "capabilities": ["GOOGLE_DEFAULT_CREDS"], "transport_security": "google_default_credentials", "uses_default_service_account": true, "uses_key_file_when_flag": true},
        {"name": "compute_engine_channel_credentials", "capabilities": ["GCE_CHANNEL_CREDS"], "transport_security": "compute_engine_channel_creds", "uses_default_service_account": true}
      ]
    },
    "http2_client": {
      "default_capabilities": ["HTTP2_INTEROP"],
      "cases": ["tls", "framing"]
    },
    "http2_server": {
      "default_client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"],
      "default_server_capabilities": ["HTTP2_SERVER_INTEROP"],
      "cases": [
        "rst_after_header", "rst_after_data", "rst_during_data", "goaway", "ping", "max_streams",
        {"name": "data_frame_padding", "client_capabilities": ["DATA_FRAME_PADDING"], "grpc_client_test_case": "large_unary", "transport_security": "insecure"},
        {"name": "no_df_padding_sanity_test", "client_capabilities": ["CORE_INTEROP"], "grpc_client_test_case": "large_unary", "transport_security": "insecure"}
      ]
    }
  },
  "language_defaults": {
    "repo": "grpc/grpc",
    "in_runner_languages": true,
    "included_in_all_clients": true,
    "docker_supported": true,
    "client_capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "ADVANCED_INTEROP", "SPECIAL_STATUS_MESSAGE", "TLS", "INSECURE", "AUTH_CREDS"],
    "server_capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "ADVANCED_INTEROP", "SPECIAL_STATUS_MESSAGE", "TLS", "INSECURE", "HTTP2_INTEROP"]
  },
  "languages": {
    "c++": {
      "safename": "cxx",
      "client_cmd": ["cmake/build/interop_client"],
      "server_cmd": ["cmake/build/interop_server"],
      "http2_client_cmd": ["cmake/build/http2_client"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "AUTH_KEY_FILE_FLAG", "GCE_OAUTH2", "OAUTH2_DEFAULT_ACCOUNT_ARG"],
      "client_capabilities_remove": ["SPECIAL_STATUS_MESSAGE"],
      "server_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "ALTS"]
    },
    "aspnetcore": {
      "repo": "grpc/grpc-dotnet",
      "client_cwd": "../grpc-dotnet/output/InteropTestsClient",
      "server_cwd": "../grpc-dotnet/output/InteropTestsWebsite",
      "client_cmd": ["dotnet", "exec", "InteropTestsClient.dll"],
      "server_cmd": ["dotnet", "exec", "InteropTestsWebsite.dll"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "DATA_FRAME_PADDING", "AUTH_KEY_FILE_ENV"],
      "server_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING"]
    },
    "dart": {
      "repo": "grpc/grpc-dart",
      "cwd": "../grpc-dart/interop",
      "client_cmd": ["dart", "bin/client.dart"],
      "server_cmd": ["dart", "bin/server.dart"],
      "client_capabilities_add": ["DATA_FRAME_PADDING", "AUTH_KEY_FILE_FLAG"],
      "client_capabilities_remove": ["SPECIAL_STATUS_MESSAGE"],
      "server_capabilities_remove": ["SPECIAL_STATUS_MESSAGE"]
    },
    "java": {
      "repo": "grpc/grpc-java",
      "cwd": "../grpc-java",
      "client_cmd": ["./run-test-client.sh"],
      "server_cmd": ["./run-test-server.sh"],
      "http2_client_cmd": ["./interop-testing/build/install/grpc-interop-testing/bin/http2-client"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "DATA_FRAME_PADDING", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "AUTH_KEY_FILE_FLAG"],
      "server_capabilities_add": ["SERVER_COMPRESSION_UNARY", "ORCA", "ALTS"]
    },
    "javaokhttp": {
      "safename": "java",
      "repo": "grpc/grpc-java",
      "client_cwd": "../grpc-java",
      "client_cmd": ["./run-test-client.sh", "--use_okhttp=true"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "AUTH_KEY_FILE_FLAG"]
    },
    "go": {
      "repo": "grpc/grpc-go",
      "client_cwd": "/go/src/google.golang.org/grpc/interop/client",
      "server_cwd": "/go/src/google.golang.org/grpc/interop/server",
      "http2_cwd": "/go/src/google.golang.org/grpc/interop/http2",
      "global_env": {"GO111MODULE": "on"},
      "client_cmd": ["go", "run", "client.go"],
      "server_cmd": ["go", "run", "server.go"],
      "http2_client_cmd": ["go", "run", "negative_http2_client.go"],
      "client_capabilities_add": ["ORCA", "DATA_FRAME_PADDING", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "AUTH_KEY_FILE_FLAG"],
      "server_capabilities_add": ["ORCA", "ALTS"],
      "server_capabilities_remove": ["HTTP2_INTEROP"]
    },
    "node": {
      "repo": "grpc/grpc-node",
      "cwd": "../../../../home/appuser/grpc-node",
      "http2_cwd": null,
      "client_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/native_native", "test/interop/interop_client.js"],
      "server_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/native_native", "test/interop/interop_server.js"],
      "client_capabilities_add": ["AUTH_KEY_FILE_ENV"]
    },
    "nodepurejs": {
      "repo": "grpc/grpc-node",
      "cwd": "../../../../home/appuser/grpc-node",
      "http2_cwd": null,
      "client_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/js_js", "test/interop/interop_client.js"],
      "client_capabilities_add": ["AUTH_KEY_FILE_ENV"],
      "server_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING"],
      "server_capabilities_remove": ["HTTP2_INTEROP"]
    },
    "php7": {
      "client_cmd": ["src/php/bin/interop_client.sh"],
      "server_cmd": ["src/php/bin/interop_server.sh"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "AUTH_KEY_FILE_ENV"]
    },
    "objc": {
      "included_in_all_clients": false,
      "docker_supported": false,
      "client_cwd": "src/objective-c/tests",
      "client_cmd": {"command": [], "args_mode": "extract_port_template", "port_regex": "--server_port=(\\d+)", "arg_template": "pod install && xcodebuild -workspace Tests.xcworkspace -scheme InteropTestsLocalSSL -destination name=\"iPhone 6\" HOST_PORT_LOCALSSL=localhost:{port} test"},
      "client_capabilities": ["CORE_INTEROP", "SINGLE_INVOCATION_SUITE", "AUTH_CREDS", "AUTH_KEY_FILE_FLAG", "TLS", "INSECURE"],
      "server_capabilities_remove": ["HTTP2_INTEROP"]
    },
    "ruby": {
      "client_cmd": ["tools/run_tests/interop/with_rvm.sh", "ruby", "src/ruby/pb/test/client.rb"],
      "server_cmd": ["tools/run_tests/interop/with_rvm.sh", "ruby", "src/ruby/pb/test/server.rb"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "AUTH_KEY_FILE_ENV"]
    },
    "python": {
      "global_env": {"LD_LIBRARY_PATH": "/var/local/git/grpc/libs/opt", "PYTHONPATH": "/var/local/git/grpc/src/python/gens"},
      "client_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--client"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "server_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--server"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "http2_client_cmd": ["py39/bin/python", "src/python/grpcio_tests/tests/http2/negative_http2_client.py"],
      "client_capabilities_add": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "AUTH_KEY_FILE_ENV"],
      "server_capabilities_add": ["ALTS"]
    },
    "pythonasyncio": {
      "global_env": {"LD_LIBRARY_PATH": "/var/local/git/grpc/libs/opt", "PYTHONPATH": "/var/local/git/grpc/src/python/gens"},
      "client_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--use-asyncio", "--client"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "server_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--use-asyncio", "--server"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "http2_client_cmd": ["py39/bin/python", "src/python/grpcio_tests/tests/http2/negative_http2_client.py"],
      "client_capabilities": ["CORE_INTEROP", "ADVANCED_INTEROP", "SPECIAL_STATUS_MESSAGE", "TLS", "INSECURE"],
      "server_capabilities": []
    },
    "http2": {
      "in_runner_languages": false, "included_in_all_clients": false, "is_http2_target": true,
      "client_cmd": ["tools/http2_interop/http2_interop.test", "-test.v"],
      "server_cmd": {"command": ["python test/http2_test/http2_test_server.py"], "args_mode": "ignore_args"},
      "client_capabilities": ["HTTP2_INTEROP", "TLS", "INSECURE", "ALTS"],
      "server_capabilities": ["HTTP2_SERVER_INTEROP", "INSECURE", "TLS"],
      "http2_server_client_capabilities": ["HTTP2_SERVER_INTEROP"],
      "http2_client_server_capabilities": ["HTTP2_INTEROP"]
    },
    "csharp": {
      "repo": "grpc", "in_runner_languages": false, "included_in_all_clients": false,
      "client_cwd": "src/csharp/Grpc.IntegrationTesting.Client/bin/Debug/net45",
      "server_cwd": "src/csharp/Grpc.IntegrationTesting.Server/bin/Debug/net45",
      "client_cmd": ["mono", "Grpc.IntegrationTesting.Client.exe"],
      "server_cmd": ["mono", "Grpc.IntegrationTesting.Server.exe"],
      "client_capabilities_add": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "AUTH_KEY_FILE_ENV"]
    }
  },
  "matrix": {
    "runtime_testcases_prefix_overrides": {
      "csharpcoreclr": {"lang": "csharp", "replace_from": "csharp_", "replace_to": "csharpcoreclr_"}
    },
    "languages": {

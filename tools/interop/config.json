{
  "$schema": "./config.schema.json",
  "schema_version": "3.0",
  "capabilities": [
    "CORE_INTEROP", "ADVANCED_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING",
    "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "SPECIAL_STATUS_MESSAGE", "DATA_FRAME_PADDING", "ORCA",
    "SINGLE_INVOCATION_SUITE", "AUTH_CREDS", "AUTH_KEY_FILE_FLAG", "AUTH_KEY_FILE_ENV", "GOOGLE_DEFAULT_CREDS",
    "GCE_CHANNEL_CREDS", "GCE_OAUTH2", "OAUTH2_DEFAULT_ACCOUNT_ARG", "HTTP2_INTEROP", "HTTP2_SERVER_INTEROP",
    "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "TLS", "INSECURE", "ALTS"
  ],
  "prod_servers": {
    "default": "grpc-test.sandbox.googleapis.com",
    "gateway_v4": "grpc-test4.sandbox.googleapis.com"
  },
  "prod_server_capabilities": [
    "CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "HTTP2_INTEROP", "AUTH_CREDS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS", "TLS"
  ],
  "server_order": ["c++", "node", "aspnetcore", "java", "go", "ruby", "python", "dart", "pythonasyncio", "php7"],
  "http2_badserver_client_order": ["java", "go", "python", "c++"],
  "alts_language_order": ["java", "go", "c++", "python"],
  "test_cases": {
    "standard": [
      {"name": "large_unary", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "empty_unary", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "ping_pong", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "empty_stream", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "client_streaming", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "server_streaming", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "cancel_after_begin", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "cancel_after_first_response", "capabilities": ["CORE_INTEROP"], "cloud_to_prod": true},
      {"name": "timeout_on_sleeping_server", "capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER"], "cloud_to_prod": true},
      {"name": "custom_metadata", "capabilities": ["CORE_INTEROP", "ADVANCED_INTEROP"]},
      {"name": "status_code_and_message", "capabilities": ["CORE_INTEROP", "ADVANCED_INTEROP"]},
      {"name": "unimplemented_method", "capabilities": ["CORE_INTEROP", "ADVANCED_INTEROP"]},
      {"name": "client_compressed_unary", "capabilities": ["CORE_INTEROP", "CLIENT_COMPRESSION_UNARY"]},
      {"name": "server_compressed_unary", "capabilities": ["CORE_INTEROP", "SERVER_COMPRESSION_UNARY"]},
      {"name": "client_compressed_streaming", "capabilities": ["CORE_INTEROP", "CLIENT_COMPRESSION_STREAMING"]},
      {"name": "server_compressed_streaming", "capabilities": ["CORE_INTEROP", "SERVER_COMPRESSION_STREAMING"]},
      {"name": "unimplemented_service", "capabilities": ["CORE_INTEROP", "ADVANCED_INTEROP"]},
      {"name": "special_status_message", "capabilities": ["CORE_INTEROP", "SPECIAL_STATUS_MESSAGE"]},
      {"name": "orca_per_rpc", "capabilities": ["CORE_INTEROP", "ORCA"], "extra_cloud_to_cloud_flags": ["--service_config_json='{\"loadBalancingConfig\":[{\"test_backend_metrics_load_balancer\":{}}]}'"]},
      {"name": "orca_oob", "capabilities": ["CORE_INTEROP", "ORCA"], "extra_cloud_to_cloud_flags": ["--service_config_json='{\"loadBalancingConfig\":[{\"test_backend_metrics_load_balancer\":{}}]}'"]}
    ],
    "auth": [
      {"name": "compute_engine_creds", "capabilities": ["AUTH_CREDS"], "requires_compute_engine_creds": true, "uses_oauth_scope": true, "uses_default_service_account": true},
      {"name": "jwt_token_creds", "capabilities": ["AUTH_CREDS"], "uses_service_account_key": true},
      {"name": "oauth2_auth_token", "capabilities": ["AUTH_CREDS"], "uses_service_account_key": true, "uses_oauth_scope": true, "requires_compute_engine_creds_capability": "GCE_OAUTH2", "uses_default_service_account_capability": "OAUTH2_DEFAULT_ACCOUNT_ARG"},
      {"name": "per_rpc_creds", "capabilities": ["AUTH_CREDS"], "uses_service_account_key": true, "uses_oauth_scope": true},
      {"name": "google_default_credentials", "capabilities": ["GOOGLE_DEFAULT_CREDS"], "transport_security": "google_default_credentials", "uses_service_account_key_when_flag": "google_default_creds_use_key_file", "uses_default_service_account": true},
      {"name": "compute_engine_channel_credentials", "capabilities": ["GCE_CHANNEL_CREDS"], "transport_security": "compute_engine_channel_creds", "uses_default_service_account": true}
    ],
    "http2_client": [
      {"name": "tls", "capabilities": ["HTTP2_INTEROP"]},
      {"name": "framing", "capabilities": ["HTTP2_INTEROP"]}
    ],
    "http2_server": [
      {"name": "rst_after_header", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "rst_after_data", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "rst_during_data", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "goaway", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "ping", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "max_streams", "client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT"], "server_capabilities": ["HTTP2_SERVER_INTEROP"]},
      {"name": "data_frame_padding", "client_capabilities": ["DATA_FRAME_PADDING"], "server_capabilities": ["HTTP2_SERVER_INTEROP"], "client_kind": "grpc_client", "grpc_client_test_case": "large_unary", "transport_security_override": "insecure"},
      {"name": "no_df_padding_sanity_test", "client_capabilities": ["CORE_INTEROP"], "server_capabilities": ["HTTP2_SERVER_INTEROP"], "client_kind": "grpc_client", "grpc_client_test_case": "large_unary", "transport_security_override": "insecure"}
    ]
  },
  "language_defaults": {
    "repo": "grpc/grpc",
    "in_runner_languages": true,
    "included_in_all_clients": true,
    "supports_server": true,
    "docker_supported": true,
    "auth_credentials_mode": "env",
    "client_capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "ADVANCED_INTEROP", "SPECIAL_STATUS_MESSAGE", "AUTH_CREDS", "AUTH_KEY_FILE_ENV", "TLS", "INSECURE"],
    "server_capabilities": ["CORE_INTEROP", "TIMEOUT_ON_SLEEPING_SERVER", "ADVANCED_INTEROP", "SPECIAL_STATUS_MESSAGE", "HTTP2_INTEROP", "TLS", "INSECURE"]
  },
  "languages": {
    "c++": {
      "safename": "cxx",
      "auth_credentials_mode": "flag",
      "client_cmd": ["cmake/build/interop_client"],
      "server_cmd": ["cmake/build/interop_server"],
      "http2_client_cmd": ["cmake/build/http2_client"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "GCE_OAUTH2", "OAUTH2_DEFAULT_ACCOUNT_ARG"],
      "remove_client_capabilities": ["SPECIAL_STATUS_MESSAGE"],
      "add_server_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "ALTS"]
    },
    "aspnetcore": {
      "repo": "grpc/grpc-dotnet",
      "client_cwd": "../grpc-dotnet/output/InteropTestsClient",
      "server_cwd": "../grpc-dotnet/output/InteropTestsWebsite",
      "client_cmd": ["dotnet", "exec", "InteropTestsClient.dll"],
      "server_cmd": ["dotnet", "exec", "InteropTestsWebsite.dll"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "DATA_FRAME_PADDING"],
      "add_server_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING"]
    },
    "dart": {
      "repo": "grpc/grpc-dart",
      "auth_credentials_mode": "flag",
      "client_cwd": "../grpc-dart/interop",
      "server_cwd": "../grpc-dart/interop",
      "http2_cwd": "../grpc-dart/interop",
      "client_cmd": ["dart", "bin/client.dart"],
      "server_cmd": ["dart", "bin/server.dart"],
      "add_client_capabilities": ["DATA_FRAME_PADDING"],
      "remove_client_capabilities": ["SPECIAL_STATUS_MESSAGE"],
      "remove_server_capabilities": ["SPECIAL_STATUS_MESSAGE"]
    },
    "java": {
      "repo": "grpc/grpc-java",
      "auth_credentials_mode": "flag",
      "client_cwd": "../grpc-java",
      "server_cwd": "../grpc-java",
      "http2_cwd": "../grpc-java",
      "client_cmd": ["./run-test-client.sh"],
      "server_cmd": ["./run-test-server.sh"],
      "http2_client_cmd": ["./interop-testing/build/install/grpc-interop-testing/bin/http2-client"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "DATA_FRAME_PADDING", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS"],
      "add_server_capabilities": ["SERVER_COMPRESSION_UNARY", "ORCA", "ALTS"]
    },
    "javaokhttp": {
      "safename": "java",
      "repo": "grpc/grpc-java",
      "supports_server": false,
      "auth_credentials_mode": "flag",
      "client_cwd": "../grpc-java",
      "client_cmd": ["./run-test-client.sh", "--use_okhttp=true"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING", "ORCA", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS"],
      "server_capabilities": []
    },
    "go": {
      "repo": "grpc/grpc-go",
      "auth_credentials_mode": "flag",
      "client_cwd": "/go/src/google.golang.org/grpc/interop/client",
      "server_cwd": "/go/src/google.golang.org/grpc/interop/server",
      "http2_cwd": "/go/src/google.golang.org/grpc/interop/http2",
      "global_env": {"GO111MODULE": "on"},
      "client_cmd": ["go", "run", "client.go"],
      "server_cmd": ["go", "run", "server.go"],
      "http2_client_cmd": ["go", "run", "negative_http2_client.go"],
      "add_client_capabilities": ["ORCA", "DATA_FRAME_PADDING", "HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS", "GOOGLE_DEFAULT_CREDS", "GCE_CHANNEL_CREDS"],
      "add_server_capabilities": ["ORCA", "ALTS"],
      "remove_server_capabilities": ["HTTP2_INTEROP"]
    },
    "node": {
      "repo": "grpc/grpc-node",
      "client_cwd": "../../../../home/appuser/grpc-node",
      "server_cwd": "../../../../home/appuser/grpc-node",
      "client_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/native_native", "test/interop/interop_client.js"],
      "server_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/native_native", "test/interop/interop_server.js"]
    },
    "nodepurejs": {
      "repo": "grpc/grpc-node",
      "supports_server": false,
      "client_cwd": "../../../../home/appuser/grpc-node",
      "server_cwd": "../../../../home/appuser/grpc-node",
      "client_cmd": ["packages/grpc-native-core/deps/grpc/tools/run_tests/interop/with_nvm.sh", "node", "--require", "./test/fixtures/js_js", "test/interop/interop_client.js"],
      "add_server_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING", "SERVER_COMPRESSION_UNARY", "SERVER_COMPRESSION_STREAMING"],
      "remove_server_capabilities": ["HTTP2_INTEROP"]
    },
    "php7": {
      "client_cmd": ["src/php/bin/interop_client.sh"],
      "server_cmd": ["src/php/bin/interop_server.sh"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING"]
    },
    "objc": {
      "included_in_all_clients": false,
      "supports_server": false,
      "docker_supported": false,
      "auth_credentials_mode": "flag",
      "client_cwd": "src/objective-c/tests",
      "client_cmd": {"args_mode": "extract_port_template", "port_regex": "--server_port=(\\d+)", "arg_template": "pod install && xcodebuild -workspace Tests.xcworkspace -scheme InteropTestsLocalSSL -destination name=\"iPhone 6\" HOST_PORT_LOCALSSL=localhost:{port} test"},
      "client_capabilities": ["CORE_INTEROP", "SINGLE_INVOCATION_SUITE", "AUTH_CREDS", "AUTH_KEY_FILE_FLAG", "TLS", "INSECURE"],
      "remove_server_capabilities": ["HTTP2_INTEROP"]
    },
    "ruby": {
      "client_cmd": ["tools/run_tests/interop/with_rvm.sh", "ruby", "src/ruby/pb/test/client.rb"],
      "server_cmd": ["tools/run_tests/interop/with_rvm.sh", "ruby", "src/ruby/pb/test/server.rb"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING"]
    },
    "python": {
      "global_env": {"LD_LIBRARY_PATH": "/var/local/git/grpc/libs/opt", "PYTHONPATH": "/var/local/git/grpc/src/python/gens"},
      "client_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--client"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "server_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--server"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "http2_client_cmd": ["py39/bin/python", "src/python/grpcio_tests/tests/http2/negative_http2_client.py"],
      "add_client_capabilities": ["HTTP2_BADSERVER_CLIENT", "HTTP2_BADPEER_CLIENT", "ALTS"],
      "add_server_capabilities": ["ALTS"]
    },
    "pythonasyncio": {
      "global_env": {"LD_LIBRARY_PATH": "/var/local/git/grpc/libs/opt", "PYTHONPATH": "/var/local/git/grpc/src/python/gens"},
      "client_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--use-asyncio", "--client"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "server_cmd": {"command": ["py39/bin/python", "src/python/grpcio_tests/setup.py", "run_interop", "--use-asyncio", "--server"], "args_mode": "joined_flag", "arg_template": "--args=\"{args}\""},
      "http2_client_cmd": ["py39/bin/python", "src/python/grpcio_tests/tests/http2/negative_http2_client.py"],
      "remove_client_capabilities": ["TIMEOUT_ON_SLEEPING_SERVER", "AUTH_CREDS", "AUTH_KEY_FILE_ENV"],
      "server_capabilities": []
    },
    "http2": {
      "in_runner_languages": false,
      "included_in_all_clients": false,
      "supports_server": false,
      "is_http2_target": true,
      "auth_credentials_mode": "flag",
      "client_cmd": ["tools/http2_interop/http2_interop.test", "-test.v"],
      "server_cmd": {"command": ["python test/http2_test/http2_test_server.py"], "args_mode": "ignore_args"},
      "client_capabilities": ["HTTP2_INTEROP", "TLS", "INSECURE", "ALTS"],
      "server_capabilities": ["HTTP2_SERVER_INTEROP", "INSECURE", "TLS"],
      "http2_server_client_capabilities": ["HTTP2_SERVER_INTEROP"],
      "http2_client_server_capabilities": ["HTTP2_INTEROP"]
    },
    "csharp": {
      "repo": "grpc",
      "in_runner_languages": false,
      "included_in_all_clients": false,
      "supports_server": false,
      "client_cwd": "src/csharp/Grpc.IntegrationTesting.Client/bin/Debug/net45",
      "server_cwd": "src/csharp/Grpc.IntegrationTesting.Server/bin/Debug/net45",
      "client_cmd": ["mono", "Grpc.IntegrationTesting.Client.exe"],
      "server_cmd": ["mono", "Grpc.IntegrationTesting.Server.exe"],
      "add_client_capabilities": ["CLIENT_COMPRESSION_UNARY", "CLIENT_COMPRESSION_STREAMING"]
    }
  },
